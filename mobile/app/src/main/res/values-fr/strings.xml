        <item>Fa♯</item>
        <item>Sol</item>
        <item>Sol♯</item>
        <item>La</item>
        <item>La♯</item>
        <item>Si</item>
    </string-array>

    <!-- Claviers -->
    <string name="disp_15_3">15 notes, 3 rangées</string>
    <string name="disp_15_3_detail">Trois rangées de 5 touches : luth, flûte, violon, lyre…</string>
    <string name="disp_15_2">15 notes, 2 rangées</string>
    <string name="disp_15_2_detail">Une rangée de 7 touches et une de 8</string>
    <string name="disp_22">22 notes, 3 rangées</string>
    <string name="disp_22_detail">Piano sans touches noires : 7, 7 et 8 touches</string>
    <string name="disp_37">37 notes, piano complet</string>
    <string name="disp_37_detail">Toutes les touches, noires comprises : 12, 12 et 13</string>

    <!-- Bienvenue -->
    <string name="bienvenue_titre">Bienvenue !</string>
    <string name="bienvenue_texte">DodoTopia joue tes morceaux dans Heartopia : il appuie sur les touches de l\'instrument à ta place. Trois étapes et c\'est parti.</string>
    <string name="etape_1_titre">Autorise DodoTopia</string>
    <string name="etape_1_texte">Active le service d\'accessibilité « DodoTopia » : c\'est lui qui appuie sur l\'écran et affiche la bulle dans le jeu.</string>
    <string name="etape_2_titre">Calibre les touches</string>
    <string name="etape_2_texte">Dans le jeu, ouvre un instrument, touche la bulle et pose les pastilles sur les touches. Une seule fois par instrument.</string>
    <string name="etape_3_titre">Joue</string>
    <string name="etape_3_texte">Choisis un morceau dans la bulle et lance la lecture. Volume bas met en pause à tout moment.</string>
