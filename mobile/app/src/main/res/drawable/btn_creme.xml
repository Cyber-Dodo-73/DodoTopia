<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:bottom="3dp"><shape><solid android:color="@color/c_line" /><corners android:radius="999dp" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp"><shape><solid android:color="@color/c_bord" /><corners android:radius="999dp" /></shape></item>
            <item android:top="2dp" android:bottom="1dp"><shape><solid android:color="@color/c_surface_2" /><corners android:radius="999dp" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="0dp"><shape><solid android:color="@color/c_bord" /><corners android:radius="999dp" /></shape></item>
            <item android:top="0dp" android:bottom="3dp"><shape><solid android:color="@color/c_surface_2" /><corners android:radius="999dp" /></shape></item>
        </layer-list>
    </item>
</selector>
