<?xml version="1.0" encoding="utf-8"?>
<!-- Carte de mesure en cours (ébauche « en lecture »). Non tactile : les appuis envoyés passent au travers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panneau_fond"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/carteIcone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/rond_ambre"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_note"
                android:tint="@color/blanc"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/carteRole"
                    style="@style/Texte.Petit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/c_ambre_texte" />

                <TextView
                    android:id="@+id/carteTitre"
                    style="@style/Titre.Encre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/carteCompte"
                style="@style/Compte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pilule_ambre" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/carteBarre"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/progression" />

            <TextView
                android:id="@+id/carteTemps"
                style="@style/Texte.Petit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/carteMeta"
            style="@style/Texte.Petit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1" />
</LinearLayout>
