<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtReperes"
        style="@style/Texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlacer"
            style="@style/BoutonOverlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reperes_placer" />

        <Button
            android:id="@+id/btnEffacerReperes"
            style="@style/BoutonOverlay.Contour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/reperes_effacer" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtBpm"
        style="@style/Texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <SeekBar
        android:id="@+id/seekBpm"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:max="240"
        android:min="60" />

    <TextView
        android:id="@+id/txtAppuis"
        style="@style/Texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <SeekBar
        android:id="@+id/seekAppuis"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:max="64"
        android:min="4" />

    <TextView
        android:id="@+id/txtDuree"
        style="@style/Texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <!-- Par pas de 10 ms : 2 à 20, soit 20 à 200 ms. -->
    <SeekBar
        android:id="@+id/seekDuree"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:max="20"
        android:min="2" />

    <CheckBox
        android:id="@+id/chkAccord"
        style="@style/Texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:text="@string/accord" />
</LinearLayout>
