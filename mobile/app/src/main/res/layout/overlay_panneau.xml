<?xml version="1.0" encoding="utf-8"?>
<!-- Menu de la bulle (ébauche « bulle ouverte »), avec les outils de test de l'étape 1 à la place des trois activités. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panneau_fond"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-3dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ongletMetronome"
                style="@style/Onglet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/onglet_ambre"
                android:text="@string/onglet_metronome"
                android:textColor="@color/c_ambre_encre" />

            <TextView
                android:id="@+id/ongletReperes"
                style="@style/Onglet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/onglet_rose"
                android:text="@string/onglet_reperes"
                android:textColor="@color/c_rose_encre" />

            <TextView
                android:id="@+id/ongletCapture"
                style="@style/Onglet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/onglet_menthe"
                android:text="@string/onglet_capture"
                android:textColor="@color/c_menthe_encre" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/enteteIcone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/rond_ambre"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_note"
                android:tint="@color/blanc"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/enteteRole"
                    style="@style/Texte.Petit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/c_ambre_texte" />

                <TextView
                    android:id="@+id/enteteTitre"
                    style="@style/Titre.Encre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/enteteCompte"
                style="@style/Compte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pilule_ambre" />
        </LinearLayout>

        <!-- Métronome : réglages à gauche, gros bouton rond à droite -->
        <LinearLayout
            android:id="@+id/pageMetronome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/encart"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp">

                    <TextView
                        style="@style/Texte"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tempo" />

                    <ImageView
                        android:id="@+id/tempoMoins"
                        style="@style/BoutonRond"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/moins"
                        android:src="@drawable/ic_moins"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:id="@+id/tempoValeur"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/c_ink"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/tempoPlus"
                        style="@style/BoutonRond"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/plus"
                        android:src="@drawable/ic_plus"
                        tools:ignore="UseAppTint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/encart"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp">

                    <TextView
                        style="@style/Texte"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appuis" />

                    <ImageView
                        android:id="@+id/appuisMoins"
                        style="@style/BoutonRond"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/moins"
                        android:src="@drawable/ic_moins"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:id="@+id/appuisValeur"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/c_ink"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/appuisPlus"
                        style="@style/BoutonRond"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/plus"
                        android:src="@drawable/ic_plus"
                        tools:ignore="UseAppTint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/encart"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp">

                    <TextView
                        style="@style/Texte"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/duree" />

                    <ImageView
                        android:id="@+id/dureeMoins"
                        style="@style/BoutonRond"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/moins"
                        android:src="@drawable/ic_moins"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:id="@+id/dureeValeur"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka_semibold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/c_ink"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/dureePlus"
                        style="@style/BoutonRond"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/plus"
                        android:src="@drawable/ic_plus"
                        tools:ignore="UseAppTint" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnLancer"
                    android:layout_width="60dp"
                    android:layout_height="64dp"
                    android:background="@drawable/rond_lancer"
                    android:clickable="true"
                    android:contentDescription="@string/lancer"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp"
                    android:src="@drawable/ic_lecture"
                    android:tint="@color/blanc"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/chipAccord"
                    style="@style/Onglet"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/onglet_ambre"
                    android:minHeight="32dp"
                    android:text="@string/accord"
                    android:textColor="@color/c_ambre_encre" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pageReperes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Texte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/encart"
                android:padding="10dp"
                android:text="@string/reperes_aide" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPlacer"
                    style="@style/Bouton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reperes_placer" />

                <TextView
                    android:id="@+id/btnEffacerReperes"
                    style="@style/Bouton.Contour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/reperes_effacer" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pageCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Texte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/encart"
                android:padding="10dp"
                android:text="@string/capture_service_aide" />

            <TextView
                android:id="@+id/btnCaptureService"
                style="@style/Bouton.Teal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/capture_service" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtResume"
            style="@style/Texte.Mesure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/encart"
            android:padding="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lienOuvrir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:fontFamily="@font/nunito_extrabold"
                android:paddingVertical="4dp"
                android:text="@string/ouvrir_dodotopia"
                android:textColor="@color/c_cta"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_volume"
                android:tint="@color/c_text_2"
                tools:ignore="UseAppTint" />

            <TextView
                style="@style/Texte.Petit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rappel_stop" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
