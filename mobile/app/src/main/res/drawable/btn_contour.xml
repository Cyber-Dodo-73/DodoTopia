<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/c_line" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/c_line" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/c_line_2" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/c_surface_2" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/c_line_2" /></shape>
    </item>
</selector>
