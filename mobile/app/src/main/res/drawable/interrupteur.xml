<?xml version="1.0" encoding="utf-8"?>
<!-- Interrupteur 54×32 des ébauches : piste teal quand il est activé, bouton blanc de 24 dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item><shape><solid android:color="@color/c_line" /><corners android:radius="999dp" /></shape></item>
            <item android:left="4dp" android:right="26dp" android:top="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="@color/blanc" /></shape></item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="@color/c_cta" /><corners android:radius="999dp" /></shape></item>
            <item android:left="26dp" android:right="4dp" android:top="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="@color/blanc" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="@color/c_interrupteur_off" /><corners android:radius="999dp" /></shape></item>
            <item android:left="4dp" android:right="26dp" android:top="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="@color/blanc" /></shape></item>
        </layer-list>
    </item>
</selector>
