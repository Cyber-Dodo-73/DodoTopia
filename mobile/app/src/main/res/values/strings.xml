    <string name="app_name" translatable="false">DodoTopia</string>

    <string name="service_resume">Plays your songs in Heartopia by pressing the keys for you</string>
    <string name="service_description">DodoTopia uses this service to press the screen for you in Heartopia (instrument, painting, cooking), show its bubble over the game and stop when you press volume down. It only looks at the screen during automatic cooking and drawing, to find the stove bubble and check the canvas, and nothing leaves your phone.</string>

