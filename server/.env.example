# Variables d'environnement du serveur. Dans Dokploy : onglet « Environment » du service Compose (il écrit ce .env).
# En local : copie ce fichier en `.env`. Ne le partage jamais (il contient des secrets).

# URL publique vue par les joueurs, sans / final. Sert à construire les liens (auth Discord, /dl/...).
PUBLIC_URL=https://dodotopia.cyber-dodo.fr

# Mot de passe Postgres (service `db` du docker-compose). Génère-le : python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Base de données. Avec le docker-compose fourni, laisse vide : l'URL est construite dans le compose
# (postgresql://dodo:${POSTGRES_PASSWORD}@db:5432/dodo). Vide en dehors de Docker = SQLite dans DATA_DIR/dodo.db.
#DATABASE_URL=postgresql://dodo:motdepasse@db:5432/dodo

# Application Discord (https://discord.com/developers/applications) > OAuth2.
# Redirect URL à déclarer : <PUBLIC_URL>/auth/discord/callback  (scope : identify)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# IDs Discord des administrateurs (modération), séparés par des virgules.
ADMIN_DISCORD_IDS=123456789012345678

# Jeton secret utilisé par publish_release.py (GitHub Actions, secret PUBLISH_TOKEN) pour déposer une version.
# Génère-le par exemple avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLISH_TOKEN=

# Clé publique Ed25519 (base64, 32 octets) qui vérifie la signature des manifestes de mise à jour envoyée par
# publish_release.py. Vide : la signature est facultative et n'est pas vérifiée (compatibilité). Génère la paire :
# python -c "from nacl.signing import SigningKey; import base64; k=SigningKey.generate(); print('privee', base64.b64encode(bytes(k)).decode()); print('publique', base64.b64encode(bytes(k.verify_key)).decode())"
#RELEASE_SIGNING_PUBLIC_KEY=

# Proxys autorisés à transmettre l'IP réelle du client (X-Forwarded-For), pour la limitation de débit.
# Défaut : les réseaux Docker (Traefik de Dokploy). `*` fait confiance à tout le monde : à éviter.
#FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Optionnel (valeurs par défaut) ---
# Version minimale de DodoTopia acceptée dans les salons (les clients plus vieux reçoivent version_too_old).
#MIN_CLIENT_VERSION=1.7.0
# Taille max d'un .mid déposé dans la bibliothèque (octets).
#MAX_MIDI_BYTES=2097152
# 0 pour désactiver la limitation de débit (tests uniquement).
#RATE_LIMIT=1
# Durée de vie d'une session (jours), glissante.
#SESSION_DAYS=90
# Salons : grâce après coupure (s), suppression d'un salon vide (s), joueurs max.
#ROOM_GRACE_S=60
#ROOM_EMPTY_TTL_S=120
#ROOM_MAX_PLAYERS=8

# --- Site public ---
# Lien d'invitation Discord (vide = sections Discord masquées)
COMMUNITY_DISCORD_URL=
# Mesure d'audience Plausible, sans cookie (vide = aucune mesure), ex. https://plausible.io/js/script.js
PLAUSIBLE_SCRIPT_URL=
# Balises de vérification Google Search Console / Bing Webmaster Tools (contenu seul)
SITE_VERIFICATION_GOOGLE=
SITE_VERIFICATION_BING=
# Cache mémoire des pages HTML rendues, en secondes
SITE_PAGE_TTL_S=300
# IndexNow (Bing, Yandex, Seznam…) : clé de 8 à 128 caractères parmi a-z, A-Z, 0-9 et « - ». Définie : elle est servie
# sur <PUBLIC_URL>/<clé>.txt et les pages concernées sont signalées à chaque version publiée et à chaque morceau ou
# dessin approuvé (tâche de fond, un échec est seulement journalisé). Vide = désactivé.
# Génère-la : python -c "import secrets; print(secrets.token_hex(16))"
INDEXNOW_KEY=

# --- Annonces ---
# Webhook Discord (salon > Modifier > Intégrations > Webhooks > Copier l'URL), en https. Chaque version publiée y est
# annoncée une seule fois (embed « DodoTopia x.y.z », notes, lien de téléchargement). Vide = aucune annonce.
# X et Bluesky sont annoncés par la CI (.tools/post_social.py) avec des secrets GitHub, pas depuis ce fichier.
DISCORD_ANNOUNCE_WEBHOOK=

# --- Import par lien (Online Sequencer, BitMidi, URL .mid) ---
# Hôtes autorisés pour les liens directs vers un .mid, séparés par des virgules (vide = tout hôte public ; les adresses
# privées, loopback et link-local sont toujours refusées).
#IMPORT_DIRECT_HOSTS=
#IMPORT_TIMEOUT_S=10
#IMPORT_CACHE_DAYS=7
#IMPORT_TOKEN_TTL_S=600

# --- Galerie de dessins ---
#MAX_DRAWING_PNG_BYTES=524288
#MAX_DRAWING_CELLS_BYTES=204800
#MAX_DRAWING_PX=1024
#DRAWING_THUMB_PX=400
# Fiche publique d'un morceau en `noindex` sous ce nombre de notes
#SONG_INDEX_MIN_NOTES=50
