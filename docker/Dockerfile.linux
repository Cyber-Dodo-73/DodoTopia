# Construit le bundle Linux de DodoTopia (release/DodoTopia-<version>-linux-x64.tar.gz).
# Utilisation : build-linux.bat (Windows, Docker Desktop) ou
#   docker build -f docker/Dockerfile.linux -t dodotopia-linux . && docker run --rm -v "$PWD/release:/out" dodotopia-linux
# Ubuntu 22.04 = glibc 2.35 : le binaire tourne sur Ubuntu 22.04+, Debian 12+, Fedora 36+, Arch, SteamOS 3.5+.
# Regle : toujours construire sur la distribution la plus ancienne prise en charge, puis VERIFIER sur une recente
# (etape « verify », Debian 13 par defaut ; autre cible : --build-arg VERIFY_IMAGE=ubuntu:24.04).
ARG VERIFY_IMAGE=debian:trixie-slim

# ---------------------------------------------------------------- 1. construction (Ubuntu 22.04)
FROM ubuntu:22.04 AS build
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 DODO_VENV=/opt/venv DODO_BUILD_DIR=/tmp/dodo-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip libpython3.10 binutils ca-certificates xvfb \
      libxcb-cursor0 libxkbcommon-x11-0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 \
      libxcb-shape0 libxcb-xinerama0 libxcb-randr0 libxcb-xfixes0 libnss3 libnspr4 libasound2 libgl1 libegl1 \
      libxcomposite1 libxdamage1 libxrandr2 libxtst6 libxi6 libxcursor1 libxkbfile1 libfontconfig1 libdbus-1-3 \
      libglib2.0-0 libx11-xcb1 libxrender1 libxfixes3 libxext6 libsm6 libice6 libxss1 libxshmfence1 libdrm2 libgbm1 \
      libpulse0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# dependances Python dans une couche a part (reconstruite seulement si requirements-linux.txt change)
COPY requirements-linux.txt /src/
RUN python3 -m venv "$DODO_VENV" && "$DODO_VENV/bin/pip" install --quiet --upgrade pip \
    && "$DODO_VENV/bin/pip" install --quiet --upgrade -r requirements-linux.txt && touch "$DODO_VENV/.deps-ok"
COPY . /src
# build.sh retire les bibliotheques systeme du bundle puis lance .tools/check_linux_bundle.sh sur l'archive
RUN sed -i 's/\r$//' build.sh DodoTopia.sh .tools/check_linux_bundle.sh && bash build.sh
# fumee : le binaire doit demarrer (imports, backend Qt) et rester vivant 15 s sous un serveur X virtuel
RUN cd "$DODO_BUILD_DIR/dist" && QTWEBENGINE_CHROMIUM_FLAGS="--disable-gpu --no-sandbox" QT_QPA_PLATFORM=xcb \
      xvfb-run -a timeout 15 ./DodoTopia/DodoTopia --debug; rc=$?; test $rc -eq 124 || (echo "le binaire s'est arrete (code $rc)" && exit 1)

# ---------------------------------------------------------------- 2. verification sur une distribution recente
# Paquets d'EXECUTION seulement (ceux du README) : ni Python, ni Qt. Le bundle doit s'entendre avec le Mesa et la
# libstdc++ de cette machine : c'est la panne de la 2.0.0 (libstdc++ embarquee trop ancienne pour le pilote Mesa).
FROM ${VERIFY_IMAGE} AS verify
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb xauth libgl1 libegl1 libgl1-mesa-dri libgbm1 libdrm2 libnss3 libasound2t64 libglib2.0-0t64 \
      libxcb-cursor0 libxkbcommon-x11-0 libxcomposite1 libxdamage1 libxrandr2 libxtst6 libxi6 libxkbfile1 \
      libfontconfig1 libdbus-1-3 libpulse0 ca-certificates file \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /verify
COPY --from=build /src/release/ /verify/release/
COPY --from=build /src/.tools/check_linux_bundle.sh /verify/check_linux_bundle.sh
RUN set -eu; A=$(ls release/DodoTopia-*-linux-x64.tar.gz); bash check_linux_bundle.sh --list "$A"; tar -xzf "$A"
# Controle deterministe : les pilotes Mesa du systeme, charges avec les bibliotheques du bundle en tete de recherche
# (comme le fait le chargeur de PyInstaller), ne doivent manquer ni d'une bibliotheque, ni d'un symbole, ni d'une version.
RUN set -eu; B=/verify/DodoTopia/_internal; fail=0; n=0; \
    for lib in $(find /usr/lib /lib -type f \( -name 'libGLX_mesa.so.0*' -o -name 'libEGL_mesa.so.0*' -o -name 'libgbm.so.1*' -o -name 'libgallium-*.so' \) | sort -u); do \
      n=$((n+1)); echo "== ldd -r $lib"; \
      out=$(LD_LIBRARY_PATH="$B" ldd -r "$lib" 2>&1 || true); \
      if printf '%s\n' "$out" | grep -E 'not found|undefined symbol|version `'; then echo "ECHEC : $lib ne se charge pas avec les bibliotheques du bundle"; fail=1; \
      else echo "   ok"; fi; \
      printf '%s\n' "$out" | grep -F "$B/" | sed 's/^/   pris dans le bundle :/' || true; \
    done; \
    test "$n" -ge 3 || { echo "ECHEC : pilotes Mesa introuvables sur l'image de verification ($n trouves)"; exit 1; }; \
    test "$fail" -eq 0
# Meme controle dans l'autre sens : les bibliotheques Qt du bundle trouvent tout ce qu'il leur faut sur le systeme
# (sinon : paquet a ajouter aux prerequis du README, ou bibliotheque retiree a tort par build.sh).
RUN set -eu; B=/verify/DodoTopia/_internal; fail=0; \
    for lib in "$B/PyQt6/Qt6/plugins/platforms/libqxcb.so" "$B/PyQt6/Qt6/lib/libQt6WebEngineCore.so.6" \
               "$B/PyQt6/Qt6/lib/libQt6Gui.so.6" "$B/PyQt6/Qt6/lib/libQt6OpenGL.so.6" "$B/PyQt6/Qt6/libexec/QtWebEngineProcess"; do \
      test -e "$lib" || { echo "ECHEC : absent du bundle : $lib"; fail=1; continue; }; \
      echo "== ldd $lib"; \
      if LD_LIBRARY_PATH="$B:$B/PyQt6/Qt6/lib" ldd "$lib" 2>&1 | grep -E 'not found|version `'; then fail=1; else echo "   ok"; fi; \
    done; test "$fail" -eq 0
# Demarrage reel SANS --disable-gpu : Chromium charge le Mesa du systeme (llvmpipe sous Xvfb). 124 = toujours vivant apres 20 s.
RUN cd /verify && QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox" QT_QPA_PLATFORM=xcb \
      xvfb-run -a timeout 20 ./DodoTopia/DodoTopia --debug; rc=$?; \
    test $rc -eq 124 || { echo "ECHEC : le binaire s'est arrete sur l'image de verification (code $rc)"; exit 1; }
# DodoTopia.sh : executable, et suit un lien symbolique place dans le PATH
RUN set -eu; test -x /verify/DodoTopia/DodoTopia.sh; ln -s /verify/DodoTopia/DodoTopia.sh /usr/local/bin/dodotopia; \
    rc=0; DODO_NO_DESKTOP=1 DODO_SOFTWARE_RENDER=1 QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox" QT_QPA_PLATFORM=xcb \
      xvfb-run -a timeout 15 dodotopia --debug || rc=$?; \
    test $rc -eq 124 || { echo "ECHEC : le lien /usr/local/bin/dodotopia ne lance pas l'application (code $rc)"; exit 1; }
RUN touch /verified

# ---------------------------------------------------------------- 3. image finale : l'archive, une fois verifiee
FROM build
# force BuildKit a executer l'etape « verify » (une etape dont rien ne depend est sautee)
COPY --from=verify /verified /verified
CMD ["bash", "-c", "cp release/*-linux-x64.tar.gz /out/ && ls -la /out"]
