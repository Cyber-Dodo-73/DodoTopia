<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="oval"><solid android:color="@color/c_cta_edge" /></shape></item>
            <item android:top="3dp" android:bottom="1dp"><shape android:shape="oval"><solid android:color="@color/c_cta" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape android:shape="oval"><solid android:color="@color/c_cta_edge" /></shape></item>
            <item android:bottom="4dp"><shape android:shape="oval"><solid android:color="@color/c_cta" /></shape></item>
        </layer-list>
    </item>
</selector>
