# Construit le bundle Linux de DodoTopia (release/DodoTopia-<version>-linux-x64.tar.gz).
# Utilisation : build-linux.bat (Windows, Docker Desktop) ou
#   docker build -f docker/Dockerfile.linux -t dodotopia-linux . && docker run --rm -v "$PWD/release:/out" dodotopia-linux
# Ubuntu 22.04 = glibc 2.35 : le binaire tourne sur Ubuntu 22.04+, Debian 12+, Fedora 36+, Arch, SteamOS 3.5+.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 DODO_VENV=/opt/venv DODO_BUILD_DIR=/tmp/dodo-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip libpython3.10 binutils ca-certificates xvfb \
      libxcb-cursor0 libxkbcommon-x11-0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 \
      libxcb-shape0 libxcb-xinerama0 libxcb-randr0 libxcb-xfixes0 libnss3 libnspr4 libasound2 libgl1 libegl1 \
      libxcomposite1 libxdamage1 libxrandr2 libxtst6 libxi6 libxcursor1 libxkbfile1 libfontconfig1 libdbus-1-3 \
      libglib2.0-0 libx11-xcb1 libxrender1 libxfixes3 libxext6 libsm6 libice6 libxss1 libxshmfence1 libdrm2 libgbm1 \
      libpulse0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# dependances Python dans une couche a part (reconstruite seulement si requirements-linux.txt change)
COPY requirements-linux.txt /src/
RUN python3 -m venv "$DODO_VENV" && "$DODO_VENV/bin/pip" install --quiet --upgrade pip \
    && "$DODO_VENV/bin/pip" install --quiet --upgrade -r requirements-linux.txt && touch "$DODO_VENV/.deps-ok"
COPY . /src
RUN sed -i 's/\r$//' build.sh DodoTopia.sh && bash build.sh
# fumee : le binaire doit demarrer (imports, backend Qt) et rester vivant 15 s sous un serveur X virtuel
RUN cd "$DODO_BUILD_DIR/dist" && QTWEBENGINE_CHROMIUM_FLAGS="--disable-gpu --no-sandbox" QT_QPA_PLATFORM=xcb \
      xvfb-run -a timeout 15 ./DodoTopia/DodoTopia --debug; rc=$?; test $rc -eq 124 || (echo "le binaire s'est arrete (code $rc)" && exit 1)
CMD ["bash", "-c", "cp release/*-linux-x64.tar.gz /out/ && ls -la /out"]
