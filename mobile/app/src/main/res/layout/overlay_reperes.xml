<?xml version="1.0" encoding="utf-8"?>
<!-- Barre du calibrage du dessin : quatre repères à poser, puis valider. Elle se déplace au doigt
     (Overlay.rendreDeplacable) : posée en haut au centre, elle peut cacher la toile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/panneau_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        style="@style/Texte.Petit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/barre_deplacer"
        android:text="⋮⋮"
        android:textColor="@color/c_text_2"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/reperesAide"
        style="@style/Texte.Petit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:maxWidth="300dp"
        android:maxLines="3"
        android:text="@string/reperes_aide"
        android:textColor="@color/c_text" />

    <TextView
        android:id="@+id/btnAnnuler"
        style="@style/Bouton.Petit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_contour"
        android:text="@string/annuler"
        android:textColor="@color/c_text" />

    <TextView
        android:id="@+id/btnOk"
        style="@style/Bouton.Petit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/btn_teal"
        android:text="@string/valider"
        android:textColor="@color/blanc" />
</LinearLayout>
