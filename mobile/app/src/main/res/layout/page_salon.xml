<?xml version="1.0" encoding="utf-8"?>
<!-- Salon : créer ou rejoindre, puis le salon lui-même (joueurs, morceau, prêt, départ). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSalon"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salon_titre"
            android:textSize="19sp" />

        <TextView
            style="@style/Texte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/salon_aide" />

        <TextView
            android:id="@+id/salonMessage"
            style="@style/Texte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/encart_ambre"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:textColor="@color/c_ambre_encre"
            android:visibility="gone" />

        <!-- Hors salon -->
        <LinearLayout
            android:id="@+id/salonHors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Carte"
                android:orientation="vertical">

                <TextView
                    style="@style/Libelle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/salon_creer_titre" />

                <TextView
                    style="@style/Texte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/salon_creer_aide" />

                <TextView
                    android:id="@+id/salonCreer"
                    style="@style/Bouton.Teal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/salon_creer" />
            </LinearLayout>

            <LinearLayout
                style="@style/Carte"
                android:orientation="vertical">

                <TextView
                    style="@style/Libelle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/salon_rejoindre_titre" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/salonCode"
                        style="@style/Champ"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/salon_code"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="8" />

                    <TextView
                        android:id="@+id/salonRejoindre"
                        style="@style/Bouton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/salon_rejoindre" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Dans un salon -->
        <LinearLayout
            android:id="@+id/salonDans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                style="@style/Carte"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/salon_code_partage" />

                    <TextView
                        android:id="@+id/salonCodeGrand"
                        style="@style/Titre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:textColor="@color/c_ink"
                        android:textSize="30sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/salonPartager"
                    style="@style/Bouton.Petit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_contour"
                    android:text="@string/salon_partager"
                    android:textColor="@color/c_text" />
            </LinearLayout>

            <LinearLayout
                style="@style/Carte"
                android:orientation="vertical">

                <TextView
                    style="@style/Libelle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/salon_morceau" />

                <TextView
                    android:id="@+id/salonMorceauNom"
                    style="@style/Texte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/salonChoisir"
                    style="@style/Bouton.Petit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/salon_choisir" />

                <!-- Un morceau se joue sans moi : le rejoindre là où en sont les autres -->
                <TextView
                    android:id="@+id/salonRejoindreLecture"
                    style="@style/Bouton.Petit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_teal"
                    android:text="@string/salon_rejoindre_lecture"
                    android:textColor="@color/blanc"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Orchestre : le chef répartit les pistes du morceau entre les joueurs -->
            <LinearLayout
                android:id="@+id/salonOrchestre"
                style="@style/Carte"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Libelle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/orchestre_titre" />

                <TextView
                    android:id="@+id/salonOrchestreEtat"
                    style="@style/Texte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:id="@+id/salonOrchestreBoutons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/salonRepartir"
                        style="@style/Bouton.Petit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/orchestre_repartir" />

                    <TextView
                        android:id="@+id/salonToutJouer"
                        style="@style/Bouton.Petit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_contour"
                        android:text="@string/orchestre_arreter"
                        android:textColor="@color/c_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Carte"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/salonJoueursTitre"
                    style="@style/Libelle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/salonJoueurs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/salonPretAppli"
                style="@style/Bouton.Grand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/salon_pret" />

            <TextView
                android:id="@+id/salonLancerAppli"
                style="@style/Bouton.Teal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:text="@string/salon_lancer"
                android:textSize="15sp" />

            <!-- Avance / retard : réglage personnel ajouté à l'heure de départ -->
            <LinearLayout
                style="@style/Carte"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Libelle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/salon_avance_retard" />

                    <TextView
                        style="@style/Texte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/salon_avance_retard_aide" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/salonRetardMoins"
                    style="@style/BoutonRond"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/moins"
                    android:focusable="true"
                    android:src="@drawable/ic_moins" />

                <TextView
                    android:id="@+id/salonRetardValeur"
                    style="@style/Libelle"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/salonRetardPlus"
                    style="@style/BoutonRond"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/plus"
                    android:focusable="true"
                    android:src="@drawable/ic_plus" />
            </LinearLayout>

            <TextView
                style="@style/Texte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/encart"
                android:padding="12dp"
                android:text="@string/salon_astuce" />

            <TextView
                android:id="@+id/salonQuitter"
                style="@style/Bouton.Contour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/salon_quitter" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
